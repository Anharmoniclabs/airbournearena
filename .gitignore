# dependencies
node_modules/
.tools/

# build output
Airbourne-Arena/source/dist/
Airbourne-Arena/source/.next/
Airbourne-Arena/source/.vinext/
Airbourne-Arena/source/.vite/

# local tooling state (npm cache, HOME, tmp — created by scripts/sites-env.sh)
Airbourne-Arena/source/.sites-runtime/
Airbourne-Arena/source/.wrangler/

# local env
.env
.env.*
!.env.example

# the distribution archive the working tree was extracted from; the extracted
# tree is what is tracked, so keeping both would double the repo for nothing
*.zip

# Where scripts/convert-generated-art.mjs unpacks the AI Toolkit art drop. The
# converted GLBs under Airbourne-Arena/assets/ are what ships; this is the
# 146 MB Unity project they were cut from.
/.art-source/

# editor / OS
.DS_Store
*.swp

# Blender writes a .blend1 backup beside every save; it is the previous
# revision of a file git already versions.
*.blend1

# Scratch copies of the game dropped beside it while testing. index.html is
# generated from src/ and these are not, so a tracked one would quietly become a
# third divergent copy of an 8,000-line file.
Airbourne-Arena/__*.html
Airbourne-Arena/unity-import/
Airbourne-Arena/UnityProject/[Ll]ibrary/
Airbourne-Arena/UnityProject/[Tt]emp/
Airbourne-Arena/UnityProject/[Oo]bj/
Airbourne-Arena/UnityProject/[Ll]ogs/
Airbourne-Arena/UnityProject/[Uu]ser[Ss]ettings/
Airbourne-Arena/UnityProject/Tools/**/bin/
Airbourne-Arena/UnityProject/Tools/**/obj/
Airbourne-Arena/Builds/
__pycache__/

# Local Cloudflare credential dropped here during deploy setup. A global key can
# do anything on the account, so it must never be committable.
/cloud
